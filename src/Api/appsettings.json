{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=modmono;Username=postgres;Password=postgres",
    "Redis": "localhost:6379",
    "RabbitMQ": "amqp://guest:guest@localhost:5672"
  },
  "Jwt": {
    "Issuer": "ModularMonolith",
    "Audience": "ModularMonolith.Api",
    "SigningKey": "REPLACE_ME_32_CHARS_MIN",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 14
  },
  "LoggerBot": {
    "Token": "telegram-bot-token",
    "ChatId": "-100xxxxxxxxxx"
  },
  "Eskiz": {
    "Email": "your@email.uz",
    "SecretKey": "your-eskiz-secret-key"
  },
  "Cors": {
    "_comment": "Populate AllowedOrigins per environment (https://example.com). Empty + non-Development => startup fails.",
    "AllowedOrigins": []
  },
  "Otel": {
    "ServiceName": "ModularMonolith",
    "ExporterEndpoint": "http://localhost:4317"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
