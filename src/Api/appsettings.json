{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=modmono;Username=postgres;Password=postgres",
    "Redis": "localhost:6379",
    "RabbitMQ": "amqp://guest:guest@localhost:5672"
  },
  "Jwt": {
    "Issuer": "ModularMonolith",
    "Audience": "ModularMonolith.Api",
    "SigningKey": "replace-this-with-a-strong-secret-key-min-32-chars",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 14
  },
  "LoggerBot": {
    "Token": "telegram-bot-token",
    "ChatId": "-100xxxxxxxxxx"
  },
  "Eskiz": {
    "Email": "your@email.uz",
    "SecretKey": "your-eskiz-secret-key"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
